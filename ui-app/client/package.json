{
	"name": "nocode-ui",
	"version": "2.0.0",
	"description": "UI Engine for NoCode SaaS Platform",
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead"
	],
	"scripts": {
		"start": "webpack serve --config webpack.dev.js",
		"local": "webpack serve --config webpack.local.js",
		"ai": "webpack serve --config webpack.ai.js",
		"build": "webpack --config webpack.prod.js",
		"cf-local": "webpack --config webpack.prod.js --env publicUrl=https://cdn-local.modlix.com/js/dist/ ",
		"cf-dev": "webpack --config webpack.prod.js --env publicUrl=https://cdn-dev.modlix.com/js/dist/",
		"cf-stage": "webpack --config webpack.prod.js --env publicUrl=https://cdn-stage.modlix.com/js/dist/",
		"cf-prod": "webpack --config webpack.prod.js --env publicUrl=https://cdn.modlix.com/js/dist/",
		"bundle-analyze": "webpack --config webpack.prod.js --profile --json --env publicUrl=https://cdn-local.modlix.com/js/dist/ > report/stats.json && webpack-bundle-analyzer report/stats.json dist -p 1234",
		"test": "jest --watchAll",
		"coverage": "jest --coverage",
		"pretty": "prettier --write ./src || prettier --write ./__tests__",
		"generate-catalog": "npx ts-node --transpile-only scripts/generate-component-catalog.ts"
	},
	"keywords": [
		"nocode",
		"lowcode"
	],
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix",
			"git add"
		],
		"*.{html,css,less,ejs}": [
			"prettier --write",
			"git add"
		]
	},
	"author": "Kiran Kumar Grandhi",
	"contributors": [
		"Kiran Kumar Grandhi",
		"Raja Avinash Alli",
		"Akhilesh Alli",
		"Surendhar Satyavarapu",
		"Tarun Jangra",
		"Md Shagil Nizami",
		"Himanshu",
		"Roopa Soumya Kandula",
		"Chavala Venktarao",
		"Sachin B",
		"Ronak Piraka"
	],
	"license": "MIT",
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@eslint-react/eslint-plugin": "^5.18.1",
		"@eslint/js": "^10.0.1",
		"@tsconfig/recommended": "^1.0.13",
		"@types/jest": "^30.0.0",
		"@types/luxon": "^3.7.2",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"babel-loader": "^10.1.1",
		"buffer": "^6.0.3",
		"css-loader": "^7.1.4",
		"eslint": "^10.8.0",
		"globals": "^17.8.0",
		"html-webpack-plugin": "^5.6.7",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^15.2.10",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"process": "^0.11.10",
		"source-map-loader": "^5.0.0",
		"style-loader": "^4.0.0",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"webpack": "^5.108.4",
		"webpack-bundle-analyzer": "^4.10.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^6.0.0",
		"webpack-manifest-plugin": "^6.0.1"
	},
	"dependencies": {
		"@fincity/kirun-js": "^3.13.0",
		"@fincity/kirun-ui": "^1.2.1",
		"@fincity/path-reactive-state-management": "^2.10.0",
		"@monaco-editor/react": "^4.7.0",
		"axios": "^1.18.1",
		"chart.js": "^4.5.1",
		"luxon": "^3.7.2",
		"monaco-editor": "^0.56.0",
		"react": "^19.2.8",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2"
	},
	"jest": {
		"transform": {
			".(ts|tsx)": "ts-jest"
		},
		"testEnvironment": "jsdom",
		"setupFiles": [
			"<rootDir>/jest.setup.js"
		],
		"testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
		"moduleNameMapper": {
			"\\.(css|less|sass|scss)$": "<rootDir>/jest.styleMock.js",
			"^monaco-editor(/.*)?$": "<rootDir>/jest.monacoMock.js"
		},
		"moduleFileExtensions": [
			"ts",
			"tsx",
			"js"
		],
		"globals": {
			"window": {}
		}
	}
}
